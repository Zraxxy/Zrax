function Library:Unload()
    if self.Unloaded then return; end;
    if self.SetVisible then self:SetVisible(false); end;
    self.Unloaded = true;
    for _, Stop in pairs(self.DragStops) do Stop(true); end;
    for Idx = #self.Signals, 1, -1 do
        local Connection = table.remove(self.Signals, Idx);
        pcall(function() Connection:Disconnect(); end);
    end;
    if Context.BeforeUnload then Context.BeforeUnload(); end;
    for _, Event in pairs(self.Events) do Event:Destroy(); end;
    DraggingGui:Destroy(); ScreenGui:Destroy();
    if Context.AfterUnload then Context.AfterUnload(); end;
end;

