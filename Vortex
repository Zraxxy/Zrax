        if InputService.TouchEnabled and camera then
            local view = camera.ViewportSize;
            local width = math.min(PreferredSize.X.Offset, math.max(240, math.floor(view.X * 0.94)));
            local height = math.min(PreferredSize.Y.Offset, math.max(180, math.floor(view.Y * 0.86)));
