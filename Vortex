        end;
        local function Normalize(Value)
            if Dropdown.Multi then
                local Selected = {};
                if type(Value) == 'string' then Value = { [Value] = true }; end;
                if type(Value) ~= 'table' then return Selected; end;
                for Key, Entry in pairs(Value) do
                    local Candidate;
                    if type(Entry) == 'boolean' then
                        if Entry then Candidate = Key; end;
                    elseif type(Key) == 'number' then
                        Candidate = Entry;
                    end;
                    if IsAllowed(Candidate) then Selected[Candidate] = true; end;
                end;
                return Selected;
            end;
            if type(Value) == 'number' and not IsAllowed(Value) then Value = Dropdown.Values[Value]; end;
