function Library:MakeDraggable(Object, Cutoff, OutlineOnly, Handles)
    Object.Active = true;
    local StartInput, DragStart, StartPosition, Ghost;
    local function Stop(Cancel)
        if Ghost then
            if not Cancel and not Object:GetAttribute('VortexLocked') then Object.Position = Ghost.Position; end;
            Ghost:Destroy(); Ghost = nil;
        end;
        StartInput = nil;
    end;
    self.DragStops[Object] = Stop;
    local function BeginDrag(Input)
        if not IsLeftClickInput(Input) or not Object.Visible or Object:GetAttribute('VortexLocked') then return; end;
        local Point = Vector2.new(Input.Position.X, Input.Position.Y) - Object.AbsolutePosition;
        if Point.Y > (Cutoff or 40) then return; end;
        if Object:GetAttribute('VortexHeaderButtons') and Point.X >= Object.AbsoluteSize.X - 56 then return; end;
        if Library:MouseIsOverOpenedFrame() then return; end;
        Stop(true); Library:ClosePopups();
        Object:SetAttribute('VortexWasDragged', false);
        StartInput = Input; DragStart = Vector2.new(Input.Position.X, Input.Position.Y); StartPosition = Object.Position;
    end;
    for _,Handle in ipairs(Handles or {Object}) do Handle.InputBegan:Connect(BeginDrag); end;
    self:GiveSignal(InputService.InputChanged:Connect(function(Input)
        if not StartInput then return; end;
        if Object:GetAttribute('VortexLocked') then Stop(true); return; end;
        if (StartInput.UserInputType == Enum.UserInputType.Touch and Input ~= StartInput)
            or (StartInput.UserInputType ~= Enum.UserInputType.Touch and Input.UserInputType ~= Enum.UserInputType.MouseMovement) then return; end;
        local Delta = Vector2.new(Input.Position.X, Input.Position.Y) - DragStart;
        if Delta.Magnitude < 4 and not Object:GetAttribute('VortexWasDragged') then return; end;
        Object:SetAttribute('VortexWasDragged', true);
        if OutlineOnly and not Ghost then
            Ghost = Library:Create('Frame', {
                BackgroundTransparency = 1; Size = Object.Size; Position = Object.Position;
                AnchorPoint = Object.AnchorPoint; Parent = DraggingGui;
            });
            Library:Create('UIStroke', {Color = Library.AccentColor; Thickness = 1; Parent = Ghost});
        end;
        local Target = Ghost or Object;
        Target.Position = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y);
    end));
    self:GiveSignal(InputService.InputEnded:Connect(function(Input)
        if StartInput and (Input == StartInput or Input.UserInputType == Enum.UserInputType.MouseButton1) then Stop(false); end;
    end));
end;
