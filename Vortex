			KeyPicker.Value, KeyPicker.Mode = Key, Mode;
			for mode, button in buttons do
				button.TextColor3 = mode == KeyPicker.Mode and Library.AccentColor or Library.FontColor;
			end;
			KeyPicker:Update();
		end;

