function VortexUIBridge.Attach(owner, captures)
    local state=vxState(owner)
    if state.Attached then return end;state.Attached=true
    table.insert(state.VisibilityCells,captures[7])
    state.ContextActionService=captures[13]
    for _,i in ipairs({16,20,5,9}) do if captures[i] then table.insert(state.NativeRoots,captures[i]) end end
    -- Only donor chrome is recolored. The frontend's own ScreenGui and the drawing library are excluded.
    VortexFeatureRepairs.TrackGUIRoots(state,state.NativeRoots)
    if owner.ScreenGui then table.insert(state.NativeRoots,owner.ScreenGui) end
    state.NativeOnUnloadSetter=rawget(owner,'OnUnload')
    state.NativeCreateWindow=rawget(owner,'CreateWindow')
    rawset(owner,'CreateWindow',nil)
    state.Dispatch=function(_,...) return vxBuildWindow(state,table.pack(...)) end
    local old=getmetatable(owner)
    local previousIndex=type(old)=='table' and old.__index or nil
    local previousNew=type(old)=='table' and old.__newindex or nil
    local mt=type(old)=='table' and table.clone(old) or {}
    mt.__index=function(t,key)
        if state.Palette and state.Palette[key]~=nil then return state.Palette[key] end
        if key=='CreateWindow' then return state.Dispatch end
        if key=='CantDragForced' then return state.Locked end
        if state.Front[key]~=nil then return state.Front[key] end
        if type(previousIndex)=='function' then return previousIndex(t,key) end
        if type(previousIndex)=='table' then return previousIndex[key] end
        return nil
    end
    mt.__newindex=function(t,key,value)
        if state.Palette and state.Palette[key]~=nil then return end
        if state.Installing then rawset(t,key,value);return end
        if key=='CreateWindow' then
            if not state.Window then state.NativeCreateWindow=value else state.LegacyMethods[key]=value end
            return
        end
        if key=='CantDragForced' then
            state.Locked=value==true
            if state.Window then state.Window:SetLocked(state.Locked) end
            return
        end
        if state.Front[key]~=nil then
            if key=='OnUnload' and type(value)=='function' then table.insert(state.Callbacks,value)
            else state.LegacyMethods[key]=value end
            return
        end
        if type(previousNew)=='function' then previousNew(t,key,value) else rawset(t,key,value) end
    end
    setmetatable(owner,mt)
end
