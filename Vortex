VortexFeatureRepairs = {}
function VortexFeatureRepairs.Palette()
    return {
        FontColor=Color3.fromRGB(255,255,255),MainColor=Color3.fromRGB(0,0,0),
        BackgroundColor=Color3.fromRGB(8,8,8),AccentColor=Color3.fromRGB(180,180,180),
        OutlineColor=Color3.fromRGB(50,50,50),RiskColor=Color3.fromRGB(220,220,220),
        AccentColorDark=Color3.fromRGB(90,90,90),Black=Color3.fromRGB(0,0,0),Font=Enum.Font.Code,FontSize=14,
    }
end
local paletteOptionKeys={FontColor='FontColor',MainColor='MainColor',BackgroundColor='BackgroundColor',
    AccentColor='AccentColor',OutlineColor='OutlineColor',RiskColor='RiskColor',BackColor='BackgroundColor',
    NotificationColorsMain='MainColor',NotificationColorsAccent='AccentColor',
    NotificationColorsOutline='OutlineColor',NotificationColorsFont='FontColor'}
function VortexFeatureRepairs.PickerValue(state,id,color,transparency)
    local key=paletteOptionKeys[id]
    if key then return state.FixedPalette[key],0 end
    return color,transparency
end
function VortexFeatureRepairs.NormalizeInput(id,value)
    local text=tostring(value or '')
    if type(id)~='string' or not (id=='shoot_sound_custom_value' or id:match('^hit_sounds_custom') or id:match('^ambience_custom')) then return text end
    text=text:match('^%s*(.-)%s*$')
    if text=='' then return '' end
    local digits=text:match('^(%d+)$') or text:match('^rbxassetid://(%d+)$')
        or text:match('[?&]id=(%d+)') or text:match('roblox%.com/library/(%d+)') or text:match('roblox%.com/store/asset/(%d+)')
    if not digits or not digits:match('[1-9]') then return nil,'Enter a positive Roblox audio asset ID or its asset URL.' end
    return digits -- the donor audio callback adds rbxassetid:// itself; never store a double prefix.
end
function VortexFeatureRepairs.Record(state,kind,label,message)
    local diag=state.Diagnostics
    local item={Kind=kind,Control=label or 'unknown',Message=tostring(message),Time=os.clock()}
    diag.Last=item;diag.Count+=1
    if state.DiagnosticLabel then pcall(function() state.DiagnosticLabel:SetText('Last error: '..item.Control..' — '..item.Message) end) end
    table.insert(diag.Errors,item);if #diag.Errors>20 then table.remove(diag.Errors,1) end
    warn('[Vortex] '..item.Control..': '..item.Message)
    if not state.ReportingError and state.Window then
        state.ReportingError=true
        pcall(function() state.Owner:Notify(item.Control..': '..item.Message,5) end)
        state.ReportingError=false
    end
end
function VortexFeatureRepairs.Context(state,context)
    state.FixedPalette=VortexFeatureRepairs.Palette()
    state.Diagnostics={Count=0,Errors={},Recolored=0,Palette='locked Vortex black/grey',AudioNote='Roblox must grant this experience access to the asset; private/moderated audio cannot be bypassed.'}
    state.CallbackLabels=setmetatable({}, {__mode='k'})
    context.BindCallback=function(fn,id) if type(fn)=='function' then state.CallbackLabels[fn]=id end end
    context.SafeCallback=function(fn,...)
        if type(fn)~='function' then return end
        local values=table.pack(pcall(fn,...))
        if not values[1] then
            VortexFeatureRepairs.Record(state,'callback',state.CallbackLabels[fn],values[2]);return nil
        end
        return table.unpack(values,2,values.n)
    end
    context.InputValue=function(id,text)
        local value,reason=VortexFeatureRepairs.NormalizeInput(id,text)
        if value==nil then VortexFeatureRepairs.Record(state,'input',id,reason) end
        return value
    end
    context.PickerValue=function(id,color,transparency) return VortexFeatureRepairs.PickerValue(state,id,color,transparency) end
    local env=getgenv and getgenv() or _G
    env.VortexDiagnostics=state.Diagnostics
    state.GUIRoots={}
end
function VortexFeatureRepairs.LockPalette(state)
    state.Palette=state.FixedPalette
    for key in pairs(state.Palette) do rawset(state.Owner,key,nil) end
    state.Owner:UpdateColorsUsingRegistry()
end
function VortexFeatureRepairs.StyleToolbar(state,root)
    local owner=state.Owner
    local nodes={root};for _,child in ipairs(root:GetDescendants()) do table.insert(nodes,child) end
    for _,object in ipairs(nodes) do
        if object:IsA('GuiObject') then
            object.BackgroundColor3=state.FixedPalette.MainColor
            object.BorderColor3=state.FixedPalette.OutlineColor
            local properties={BackgroundColor3='MainColor',BorderColor3='OutlineColor'}
            if object:IsA('TextButton') or object:IsA('TextLabel') then
                object.TextColor3=state.FixedPalette.FontColor;properties.TextColor3='FontColor'
            elseif object:IsA('ImageButton') or object:IsA('ImageLabel') then
                object.ImageColor3=state.FixedPalette.FontColor;properties.ImageColor3='FontColor'
            end
            owner:AddToRegistry(object,properties)
        elseif object:IsA('UIStroke') then
            object.Color=state.FixedPalette.OutlineColor;owner:AddToRegistry(object,{Color='OutlineColor'})
        elseif object:IsA('UIGradient') then
            object.Color=ColorSequence.new(state.FixedPalette.MainColor,state.FixedPalette.BackgroundColor)
        end
    end
end
function VortexFeatureRepairs.PinThemeManager(manager)
    if type(manager)~='table' then return end
    local oldDefault=manager.BuiltInThemes and manager.BuiltInThemes.Default
    local values=oldDefault and table.clone(oldDefault[2]) or {}
    for id,key in pairs(paletteOptionKeys) do
        local palette=VortexFeatureRepairs.Palette()
        values[id]=palette[key]:ToHex()
